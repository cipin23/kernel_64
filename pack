#!/bin/sh

clear && rm log/boot.img-kernel && cp out/arch/arm/boot/zImage-dtb log/boot.img-kernel && python3 repack_a02.py boot.img log/boot.img-kernel log/boot_fix.img && N=$(( $(ls log/boot_fix_*.img 2>/dev/null | wc -l) + 1 )) && mv log/boot_fix.img log/boot_fix_$N.img && stat -c %s log/boot_fix_$N.img && sha256sum log/boot_fix_$N.img